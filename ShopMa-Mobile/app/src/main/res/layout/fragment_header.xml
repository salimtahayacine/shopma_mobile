<?xml version="1.0" encoding="utf-8"?>
<!-- HeaderFragment réutilisé dans : Catalogue, Panier, Recherche, Commandes -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/header_height"
    android:background="@color/primary"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/margin_medium"
    android:paddingEnd="@dimen/margin_medium">

    <TextView
        android:id="@+id/tv_header_username"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text=""
        android:textColor="@color/white"
        android:textSize="@dimen/text_medium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_header_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge"
        android:gravity="center"
        android:minWidth="@dimen/badge_min_size"
        android:minHeight="@dimen/badge_min_size"
        android:paddingStart="@dimen/badge_padding_horizontal"
        android:paddingEnd="@dimen/badge_padding_horizontal"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="@dimen/badge_text_size"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
