<?xml version="1.0" encoding="utf-8"?>
<!--
    AccueilActivity — Dashboard ShopMa.
    Structure : CoordinatorLayout > AppBarLayout (toolbar custom) + NestedScrollView + BottomNavigationView.
    Sections : Salutation + Search + Hero Banner + GridLayout 2x3 catégories + Tendances.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ═══ AppBar / Toolbar ═══ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/screen_padding_h"
            android:paddingEnd="@dimen/screen_padding_h">

            <!-- Hamburger menu -->
            <ImageButton
                android:id="@+id/btn_menu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_hamburger"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                android:layout_marginEnd="12dp" />

            <!-- Logo "ShopMa" -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- Panier avec badge -->
            <FrameLayout
                android:id="@+id/fl_cart"
                android:layout_width="@dimen/badge_container_size"
                android:layout_height="@dimen/badge_container_size"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="@dimen/badge_icon_size"
                    android:layout_height="@dimen/badge_icon_size"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cart"
                    android:contentDescription="Panier" />

                <TextView
                    android:id="@+id/tv_badge"
                    android:layout_width="@dimen/badge_min_size"
                    android:layout_height="@dimen/badge_min_size"
                    android:layout_gravity="top|end"
                    android:layout_margin="@dimen/badge_margin"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="@dimen/badge_text_size"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═══ Contenu scrollable ═══ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="@dimen/bottom_nav_height"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_h"
            android:paddingEnd="@dimen/screen_padding_h"
            android:paddingTop="@dimen/margin_medium"
            android:paddingBottom="@dimen/margin_medium">

            <!-- ─── Salutation ─── -->
            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome_message"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="@dimen/margin_large" />

            <!-- ─── Barre de recherche (clickable → RechercheActivity) ─── -->
            <LinearLayout
                android:id="@+id/ll_search_bar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search_bar"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="@dimen/section_gap">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@null"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_search_home"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- ─── Hero Banner Promo ─── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_banner_height"
                android:background="@drawable/bg_hero_banner"
                android:layout_marginBottom="@dimen/section_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="180dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hero_badge"
                        android:textColor="#CCFFFFFF"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hero_title"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/btn_hero"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/hero_btn"
                        android:textColor="@color/primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/bg_hero_btn"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_inventory"
                    android:contentDescription="@null"
                    android:alpha="0.20" />

            </FrameLayout>

            <!-- ─── Header "Catégories" / "Voir tout" ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/margin_medium">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_categories"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_voir_tout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_voir_tout"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- ─── GridLayout 2 colonnes × 3 lignes = 6 cartes catégories ─── -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:layout_marginBottom="@dimen/section_gap">

                <!-- Cellule (1,1) : Tous les produits -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_all"
                    style="@style/ShopMa.Card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:padding="14dp">
                        <FrameLayout
                            android:layout_width="@dimen/cat_icon_bg_size"
                            android:layout_height="@dimen/cat_icon_bg_size"
                            android:background="@drawable/bg_icon_green"
                            android:layout_marginBottom="8dp">
                            <ImageView
                                android:layout_width="@dimen/cat_icon_size"
                                android:layout_height="@dimen/cat_icon_size"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_inventory"
                                android:contentDescription="@null" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/card_all"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Cellule (1,2) : Électronique -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_electronics"
                    style="@style/ShopMa.Card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:padding="14dp">
                        <FrameLayout
                            android:layout_width="@dimen/cat_icon_bg_size"
                            android:layout_height="@dimen/cat_icon_bg_size"
                            android:background="@drawable/bg_icon_green"
                            android:layout_marginBottom="8dp">
                            <ImageView
                                android:layout_width="@dimen/cat_icon_size"
                                android:layout_height="@dimen/cat_icon_size"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_devices"
                                android:contentDescription="@null" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/card_electronics"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Cellule (2,1) : Bijoux -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_jewelery"
                    style="@style/ShopMa.Card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:padding="14dp">
                        <FrameLayout
                            android:layout_width="@dimen/cat_icon_bg_size"
                            android:layout_height="@dimen/cat_icon_bg_size"
                            android:background="@drawable/bg_icon_orange"
                            android:layout_marginBottom="8dp">
                            <ImageView
                                android:layout_width="@dimen/cat_icon_size"
                                android:layout_height="@dimen/cat_icon_size"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_diamond"
                                android:contentDescription="@null" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/card_jewelery"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Cellule (2,2) : Mode Homme -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_mens"
                    style="@style/ShopMa.Card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:padding="14dp">
                        <FrameLayout
                            android:layout_width="@dimen/cat_icon_bg_size"
                            android:layout_height="@dimen/cat_icon_bg_size"
                            android:background="@drawable/bg_icon_blue"
                            android:layout_marginBottom="8dp">
                            <ImageView
                                android:layout_width="@dimen/cat_icon_size"
                                android:layout_height="@dimen/cat_icon_size"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_checkroom"
                                android:contentDescription="@null" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/card_mens"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Cellule (3,1) : Mode Femme -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_womens"
                    style="@style/ShopMa.Card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:padding="14dp">
                        <FrameLayout
                            android:layout_width="@dimen/cat_icon_bg_size"
                            android:layout_height="@dimen/cat_icon_bg_size"
                            android:background="@drawable/bg_icon_pink"
                            android:layout_marginBottom="8dp">
                            <ImageView
                                android:layout_width="@dimen/cat_icon_size"
                                android:layout_height="@dimen/cat_icon_size"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_styler"
                                android:contentDescription="@null" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/card_womens"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Cellule (3,2) : Points de retrait -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_pickup"
                    style="@style/ShopMa.Card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:padding="14dp">
                        <FrameLayout
                            android:layout_width="@dimen/cat_icon_bg_size"
                            android:layout_height="@dimen/cat_icon_bg_size"
                            android:background="@drawable/bg_icon_green"
                            android:layout_marginBottom="8dp">
                            <ImageView
                                android:layout_width="@dimen/cat_icon_size"
                                android:layout_height="@dimen/cat_icon_size"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_location_on"
                                android:contentDescription="@null" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/card_pickup"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>

            <!-- ─── Section "Tendances" ─── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_tendances"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/margin_medium" />

            <!-- HorizontalScrollView débordant sur les bords (marges négatives = 20dp) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:layout_marginStart="-20dp"
                android:layout_marginEnd="-20dp">

                <LinearLayout
                    android:id="@+id/ll_tendances"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="8dp" />

            </HorizontalScrollView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ═══ Barre de navigation inférieure (fixed) ═══ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:elevation="@dimen/elevation_bottom_bar"
        app:menu="@menu/menu_bottom_nav"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
