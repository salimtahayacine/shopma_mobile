<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margin_medium">

        <!-- Photo profil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/margin_medium">

            <ImageView
                android:id="@+id/iv_photo"
                android:layout_width="@dimen/photo_profil_size"
                android:layout_height="@dimen/photo_profil_size"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera"
                android:background="@color/divider"
                android:contentDescription="Photo de profil" />

            <Button
                android:id="@+id/btn_photo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:text="@string/btn_photo"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>

        <!-- Nom -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_nom"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="@dimen/margin_medium">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_nom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email (non modifiable depuis le profil, lu depuis prefs) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_email"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="@dimen/margin_medium">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_email_profil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Adresse de livraison -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_adresse"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="@dimen/margin_large">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_adresse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPostalAddress"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Sauvegarder -->
        <Button
            android:id="@+id/btn_sauvegarder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:text="@string/btn_sauvegarder"
            style="@style/ShopMa.Button"
            android:layout_marginBottom="@dimen/margin_medium" />

        <!-- Historique des commandes -->
        <Button
            android:id="@+id/btn_historique"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:text="@string/btn_historique"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginBottom="@dimen/margin_medium" />

        <!-- Déconnexion -->
        <Button
            android:id="@+id/btn_deconnexion"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:text="@string/btn_deconnexion"
            style="@style/ShopMa.Button.Danger" />

    </LinearLayout>
</ScrollView>
