<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="horizontal"
    android:padding="@dimen/item_padding">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_order_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tv_order_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_small" />

        <TextView
            android:id="@+id/tv_order_articles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_small" />

        <TextView
            android:id="@+id/tv_order_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_price"
            android:textStyle="bold"
            android:textSize="@dimen/text_body" />

    </LinearLayout>

    <!-- Badge statut -->
    <TextView
        android:id="@+id/tv_order_statut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:paddingStart="@dimen/statut_padding_horizontal"
        android:paddingEnd="@dimen/statut_padding_horizontal"
        android:paddingTop="@dimen/statut_padding_vertical"
        android:paddingBottom="@dimen/statut_padding_vertical"
        android:textSize="@dimen/text_small"
        android:textStyle="bold" />

</LinearLayout>
