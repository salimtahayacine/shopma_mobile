<?xml version="1.0" encoding="utf-8"?>
<!--
    LoginActivity — design "Bienvenue sur ShopMa."
    Fond gris clair #F2F2F2, champs custom avec icônes, bouton pill vert.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="56dp"
        android:paddingBottom="40dp">

        <!-- ─── Logo ─── -->
        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_logo_shopma"
            android:contentDescription="@string/app_name"
            android:layout_marginBottom="20dp" />

        <!-- ─── Titre "Bienvenue sur ShopMa." (SpannableString colore le ".") ─── -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_title"
            android:textColor="@color/login_title"
            android:textSize="30sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.15"
            android:layout_marginBottom="8dp" />

        <!-- ─── Sous-titre ─── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_subtitle"
            android:textColor="@color/login_subtitle"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="36dp" />

        <!-- ─── Champ Email ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_field_login"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_email"
                android:contentDescription="@null" />

            <View
                android:layout_width="10dp"
                android:layout_height="match_parent" />

            <EditText
                android:id="@+id/et_email"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/hint_email_login"
                android:textColorHint="@color/login_hint"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:singleLine="true" />
        </LinearLayout>

        <!-- ─── Champ Mot de passe ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_field_login"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_lock"
                android:contentDescription="@null" />

            <View
                android:layout_width="10dp"
                android:layout_height="match_parent" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/hint_password"
                android:textColorHint="@color/login_hint"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:singleLine="true" />

            <!-- Toggle visibilité -->
            <ImageView
                android:id="@+id/iv_toggle_password"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="Afficher le mot de passe"
                android:alpha="0.5"
                android:padding="2dp" />
        </LinearLayout>

        <!-- ─── Ligne : Se rappeler de moi + Oublié ? ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="28dp">

            <CheckBox
                android:id="@+id/cb_remember"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_remember_me"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:buttonTint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_forgot"
                android:textColor="@color/login_link"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ─── Bouton Pill "Se connecter →" ─── -->
        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_login_arrow"
            style="@style/ShopMa.Button.Pill"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:layout_marginBottom="20dp" />

        <!-- ─── Hint démo ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_demo_hint"
            android:padding="12dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_demo_hint"
                android:textColor="@color/primary_darker"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.3" />
        </LinearLayout>

        <!-- ─── Pied : "Pas de compte ? Créer un compte" ─── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_no_account"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_register"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_create_account"
                android:textColor="@color/login_link"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
